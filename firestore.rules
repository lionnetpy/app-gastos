rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuario solo accede a su propia rama de datos (usuarios/{uid}/...).
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{sub=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}